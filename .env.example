# Supabase project (https://supabase.com/dashboard) — the publishable key is
# safe to expose in the client; authorization is enforced by RLS.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public address of the Cloudflare R2 bucket `ev4u-videos` (r2.dev URL or a
# custom domain such as https://video.ev4u.ch). Leave empty to hide videos.
PUBLIC_VIDEO_BASE_URL=

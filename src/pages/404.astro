---
import Base from "../layouts/Base.astro";
import NotFoundFallback from "../components/NotFoundFallback";

/* Diese Seite ist zwei Dinge zugleich: die ehrliche Fehlseite UND der
   Client-Fallback für Inserate, die nach dem letzten Build entstanden sind
   (GitHub Pages liefert 404.html für alles Nicht-Vorgerenderte). Genau
   deshalb darf sie nicht in den Index: sonst steht eine Seite ohne Inhalt
   unter allen möglichen URLs in den Suchergebnissen. */
---

<Base title="Seite nicht gefunden — EV4U" description="Diese Seite gibt es nicht.">
  <meta name="robots" content="noindex,follow" slot="head" />
  <NotFoundFallback client:only="react" />
</Base>

---
import { render } from "astro:content";
import Article from "../../layouts/Article.astro";
import MonatsbriefBox from "../../components/content/MonatsbriefBox";
import { getGuides, readingMinutes, type Guide } from "../../lib/content";
import { jsonLd } from "../../lib/jsonLd";

/* A Ratgeber guide — evergreen, updated in place. */
export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide, all: guides } }));
}

const { guide, all } = Astro.props as { guide: Guide; all: Guide[] };
const { Content, headings } = await render(guide);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = new URL(`${base}/ratgeber/${guide.id}`, Astro.site).href;
const others = all.filter((g) => g !== guide).slice(0, 4);

const ld = jsonLd({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.data.title,
  description: guide.data.description,
  dateModified: guide.data.updated.toISOString(),
  author: { "@type": "Organization", name: "Redaktion EV4U" },
  publisher: { "@type": "Organization", name: "EV4U" },
  mainEntityOfPage: url,
});
---

<Article
  title={guide.data.title}
  description={guide.data.description}
  crumbs={[
    { label: "Start", href: `${base}/` },
    { label: "Ratgeber", href: `${base}/ratgeber` },
    { label: guide.data.title },
  ]}
  eyebrow={{ label: `Ratgeber · ${guide.data.audience}`, href: `${base}/ratgeber` }}
  date={guide.data.updated}
  dateLabel="Aktualisiert"
  minutes={readingMinutes(guide.body)}
  headings={headings}
  ld={ld}
>
  <Content />
  <Fragment slot="after">
    {
      others.length > 0 && (
        <section class="mt-14">
          <h2 class="text-h2 font-bold text-fg">Weitere Ratgeber</h2>
          <ul class="mt-4 grid gap-3 md:grid-cols-2">
            {others.map((g) => (
              <li>
                <a href={`${base}/ratgeber/${g.id}`} class="card card-hover block p-4">
                  <span class="block text-h3 font-bold text-fg">{g.data.title}</span>
                  <span class="mt-1 block text-small text-fg2">{g.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <div class="mt-12">
      <MonatsbriefBox client:visible />
    </div>
  </Fragment>
</Article>

---
import "../index.css";
import TopBar from "../components/TopBar";
import CompareTray from "../components/CompareTray";
import PlzGate from "../components/PlzGate";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL of a page-specific preview image (og:image). */
  image?: string;
}

const {
  title = "EV4U — Der Schweizer E-Auto-Marktplatz",
  description = "EV4U — Der Schweizer E-Auto-Marktplatz für Private & Garagen. Jedes Inserat durchgerechnet: dein Stromtarif, dein Solardach, deine Kilometer. The Future is electric.",
  image,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Canonical URL for SEO + link previews (site is set in astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Preconnect to Supabase (listing data + photos) when a project is configured.
const supabaseOrigin = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Apply the saved theme before CSS paints — prevents a dark/light flash.
      try {
        if (localStorage.getItem("ev4u.theme") === "light")
          document.documentElement.classList.add("light");
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080D0B" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="EV4U" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {supabaseOrigin && <link rel="preconnect" href={supabaseOrigin} crossorigin />}
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Spline+Sans+Mono:ital,wght@0,300..700;1,300..700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="bg-nacht text-ink antialiased">
    <a
      href="#main"
      class="fixed left-4 top-4 z-[100] -translate-y-24 border border-signal bg-nacht px-4 py-2 font-mono text-[10px] uppercase tracking-[0.2em] text-signal transition-transform focus:translate-y-0"
    >
      Zum Inhalt springen
    </a>
    <div class="relative flex min-h-screen flex-col overflow-x-clip bg-nacht text-ink">
      <TopBar client:load />
      <main id="main" class="flex-1 pt-16">
        <slot />
      </main>
      <CompareTray client:load />
      <PlzGate client:load />
      <Footer />
    </div>
  </body>
</html>

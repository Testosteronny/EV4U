---
import Base from "../layouts/Base.astro";
import NotFoundPage from "../components/pages/NotFoundPage";

/* Two things at once: the honest error page AND the client fallback for
   listings and garage profiles newer than the last build (GitHub Pages
   serves 404.html for everything not prerendered). That is why it must
   stay out of the index. */
---

<Base title="Seite nicht gefunden — EV4U" description="Diese Seite gibt es nicht." noindex>
  <NotFoundPage client:only="react" />
</Base>

---
import Base from "../layouts/Base.astro";
import RechenwerkPage from "../components/pages/RechenwerkPage";
import { fetchBuildListings } from "../lib/buildListings";

// Der Build-Snapshot muss in die Insel: sonst rendert der Server aus dem
// (prozessweit gecachten) Snapshot und der Client im ersten Durchgang aus dem
// gebündelten Seed — die Auswahl im Inserats-Picker wiche ab.
const listings = await fetchBuildListings();
---

<Base
  title="Stromkosten-Rechner — was kostet mich ein E-Auto? | EV4U"
  description="Benzin gegen Strom, auf den Rappen: dein Gemeindetarif, Solar, Lade-Mix, Wartung und kantonale Verkehrssteuer — gerechnet an echten Inseraten."
>
  <RechenwerkPage client:load initial={listings} />
</Base>

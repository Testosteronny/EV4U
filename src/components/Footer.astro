---
import { TARIFF_META, fmtCH } from "../utils/swiss";

// The footer doubles as the sitemap: every destination is reachable from
// here, so nothing on the site can only be found by accident.
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const NAV = [
  { to: "/inserate", label: "Inserate" },
  { to: "/verkaufen", label: "Verkaufen" },
  { to: "/rechenwerk", label: "Rechenwerk" },
  { to: "/vergleich", label: "Vergleich" },
  { to: "/konto", label: "Konto" },
];
---

<footer class="border-t border-line bg-nacht">
  <div class="mx-auto max-w-7xl px-4 pt-16 sm:px-8">
    <div class="grid gap-10 pb-16 md:grid-cols-[2fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <span class="relative grid h-7 w-7 place-items-center bg-signal">
            <span class="absolute h-[3px] w-4 bg-white"></span>
            <span class="absolute h-4 w-[3px] bg-white"></span>
          </span>
          <span class="stretch-expand text-xl font-black text-ink">EV4U</span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
          Der Schweizer E-Auto-Marktplatz. Unabhängig, datenbasiert, gebaut für
          Entscheidungen — nicht für Klicks.
        </p>
      </div>

      <div>
        <div class="mb-4 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
          Navigation
        </div>
        <ul class="space-y-2 text-sm">
          {
            NAV.map((l) => (
              <li>
                <a
                  href={`${base}${l.to}`}
                  class="text-muted transition-colors hover:text-ink"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <div class="mb-4 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
          Kontakt
        </div>
        <ul class="space-y-2 text-sm text-muted">
          <li>
            <a
              href="mailto:hallo@ev4u.ch"
              class="transition-colors hover:text-ink">hallo@ev4u.ch</a
            >
          </li>
          <li>ev4u.ch</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-4 py-4 text-xs text-muted/80 sm:px-8"
    >
      <span>© {year} EV4U — entwickelt in der Schweiz</span>
      <span>
        Stromtarife: ElCom {TARIFF_META.period} ({fmtCH(TARIFF_META.plzCount)} PLZ)
        · Ortschaften: swisstopo
      </span>
      <span class="font-mono uppercase tracking-[0.15em]">The Future is electric.</span>
    </div>
  </div>
</footer>

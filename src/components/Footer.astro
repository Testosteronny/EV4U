---
import { TARIFF_META, fmtCH } from "../utils/swiss";

// Der Footer ist zugleich die Sitemap: alles ist von hier erreichbar — auch
// die Werkzeuge, die aus der Hauptnavigation verschwunden sind (Rechenwerk,
// Vergleich). Nichts auf der Seite ist nur zufällig auffindbar.
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const GROUPS = [
  {
    title: "Kaufen",
    links: [
      { to: "/inserate", label: "Alle Inserate" },
      { to: "/inserate?fav=1", label: "Merkliste" },
      { to: "/vergleich", label: "Vergleich" },
    ],
  },
  {
    title: "Verkaufen",
    links: [
      { to: "/verkaufen", label: "Inserat aufgeben" },
      { to: "/konto", label: "Meine Inserate" },
    ],
  },
  {
    title: "Werkzeuge",
    links: [
      { to: "/rechenwerk", label: "Stromkosten-Rechner" },
      { to: "/konto", label: "Konto & Postfach" },
    ],
  },
];
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-[88rem] px-4 pt-14 sm:px-6">
    <div class="grid gap-10 pb-14 md:grid-cols-[2fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2">
          <span class="grid h-7 w-7 place-items-center rounded-[7px] bg-accent">
            <span class="relative block h-3.5 w-3.5">
              <span class="absolute left-0 top-1.5 h-0.5 w-3.5 rounded-full bg-on-accent"
              ></span>
              <span class="absolute left-1.5 top-0 h-3.5 w-0.5 rounded-full bg-on-accent"
              ></span>
            </span>
          </span>
          <span class="text-h3 font-semibold text-fg">EV4U</span>
        </div>
        <p class="mt-4 max-w-prose text-body text-fg2">
          Der Schweizer E-Auto-Marktplatz. Unabhängig, datenbasiert, gebaut für
          Entscheidungen — nicht für Klicks.
        </p>
        <a
          href="mailto:hallo@ev4u.ch"
          class="mt-4 inline-block text-body text-accent transition-colors hover:text-accent-hover"
          >hallo@ev4u.ch</a
        >
      </div>

      {
        GROUPS.map((g) => (
          <div>
            <div class="eyebrow mb-3">{g.title}</div>
            <ul class="space-y-2">
              {g.links.map((l) => (
                <li>
                  <a
                    href={`${base}${l.to}`}
                    class="text-body text-fg2 transition-colors hover:text-fg"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-[88rem] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-5 text-micro text-fg3 sm:px-6"
    >
      <span>© {year} EV4U — entwickelt in der Schweiz</span>
      <span>
        Stromtarife: ElCom {TARIFF_META.period} ({fmtCH(TARIFF_META.plzCount)} PLZ) ·
        Ortschaften: swisstopo · Treibstoffpreise: BFS
      </span>
      <span>The Future is electric.</span>
    </div>
  </div>
</footer>

---
import Base from "../../layouts/Base.astro";
import InseratDetailPage from "../../components/pages/InseratDetailPage";
import { fetchBuildListings } from "../../lib/buildListings";
import { jsonLd } from "../../lib/jsonLd";
import { photoUrl } from "../../lib/supabase";
import { SELLER_LABEL, brandName, modelName, vehicleTitle } from "../../utils/format";
import { fmtCH } from "../../utils/swiss";
import type { Listing } from "../../data/evData";

/* Prerendered at build time from the live database — every published
   listing gets real HTML, its own <title>/OG tags and JSON-LD (the SEO/GEO
   payoff of the Astro migration). Listings created AFTER the last build
   are served by the 404.astro client fallback until the rebuild webhook
   redeploys (see docs/listing-rebuild-webhook.md). */
export async function getStaticPaths() {
  const listings = await fetchBuildListings();
  return listings.map((l) => ({ params: { slug: l.id }, props: { listing: l } }));
}

const { listing } = Astro.props as { listing: Listing };
// Derselbe (gecachte) Build-Snapshot wie auf / und /inserate. Die Insel muss
// ihn bekommen, sonst rendert der Server aus dem Snapshot und der Client im
// ersten Durchgang aus dem gebündelten Seed — die beiden weichen ab (dem Seed
// fehlen z. B. die Neupreise), und React verwirft die Hydration.
const allListings = await fetchBuildListings();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(`${base}/inserat/${listing.id}`, Astro.site).href;
const name = vehicleTitle(listing);
const title = `${name} — CHF ${fmtCH(listing.price)} | EV4U`;
const description =
  `${name}${listing.variant ? ` (${listing.variant})` : ""}, ${listing.year}, ${fmtCH(listing.km)} km · ${listing.range} km WLTP · SOH ${listing.soh} % · ` +
  `${SELLER_LABEL[listing.sellerType]} in ${listing.ort}. ${listing.note}`.slice(0, 300);
const images = (listing.photos ?? []).map(photoUrl).filter(Boolean);

const carLd = jsonLd({
  "@context": "https://schema.org",
  "@type": "Car",
  name,
  url: canonical,
  description,
  ...(images.length > 0 && { image: images }),
  brand: { "@type": "Brand", name: brandName(listing.brand) },
  model: modelName(listing.model),
  ...(listing.variant && { vehicleConfiguration: listing.variant }),
  vehicleModelDate: String(listing.year),
  mileageFromOdometer: { "@type": "QuantitativeValue", value: listing.km, unitCode: "KMT" },
  fuelType: "Electric",
  seatingCapacity: listing.seats,
  ...(listing.weightKg && {
    weight: { "@type": "QuantitativeValue", value: listing.weightKg, unitCode: "KGM" },
  }),
  offers: {
    "@type": "Offer",
    url: canonical,
    price: listing.price,
    priceCurrency: "CHF",
    itemCondition: "https://schema.org/UsedCondition",
    availability:
      listing.status === "AKTIV"
        ? "https://schema.org/InStock"
        : "https://schema.org/Reserved",
    seller: {
      "@type": listing.sellerType === "GARAGE" ? "AutoDealer" : "Person",
      name: listing.seller,
      ...(listing.ort && {
        address: { "@type": "PostalAddress", addressLocality: listing.ort, addressCountry: "CH" },
      }),
    },
  },
});

const breadcrumbLd = jsonLd({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "EV4U", item: new URL(`${base}/`, Astro.site).href },
    {
      "@type": "ListItem",
      position: 2,
      name: "Inserate",
      item: new URL(`${base}/inserate`, Astro.site).href,
    },
    { "@type": "ListItem", position: 3, name, item: canonical },
  ],
});
---

<Base title={title} description={description} image={images[0]}>
  <Fragment slot="head">
    {/* Demo cars aren't for sale: no index entry, no Offer markup. */}
    {listing.isDemo ? (
      <meta name="robots" content="noindex,follow" />
    ) : (
      <script is:inline type="application/ld+json" set:html={carLd} />
    )}
    <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
  </Fragment>
  <InseratDetailPage
    client:load
    slug={listing.id}
    initial={listing}
    all={allListings}
  />
</Base>

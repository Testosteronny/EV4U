---
import "../index.css";
import Header from "../components/Header";
import ContextBar from "../components/ContextBar";
import AccountSync from "../components/AccountSync";
import CompareTray from "../components/CompareTray";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL of a page-specific preview image (og:image). */
  image?: string;
}

const {
  title = "EV4U — Der Schweizer E-Auto-Marktplatz",
  description = "EV4U — Der Schweizer E-Auto-Marktplatz für Private & Garagen. Jedes Inserat durchgerechnet: dein Stromtarif, dein Solardach, deine Kilometer. The Future is electric.",
  image,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Canonical URL for SEO + link previews (site is set in astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Preconnect to Supabase (listing data + photos) when a project is configured.
const supabaseOrigin = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Hell ist der Default. Eine explizite Wahl gewinnt, sonst entscheidet
      // die Systempräferenz. Läuft vor dem ersten Paint — kein Flash.
      try {
        var saved = localStorage.getItem("ev4u.theme");
        var dark =
          saved === "dark" ||
          (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (dark) document.documentElement.classList.add("dark");
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FBFBFA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0F0E" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="EV4U" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {supabaseOrigin && <link rel="preconnect" href={supabaseOrigin} crossorigin />}
    {/* Eine Familie, vier Schnitte. Vorher: Archivo über die volle
        Breiten-Achse (wdth 62..125) PLUS Spline Sans Mono — beide sind
        entfallen, weil es keine stretch-*-Klassen mehr gibt und Archivo
        selbst Tabellenziffern mitbringt (font-variant-numeric: tabular-nums). */}
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="bg-canvas text-fg antialiased">
    <a
      href="#main"
      class="fixed left-4 top-4 z-100 -translate-y-24 rounded-card bg-accent px-4 py-2 text-small font-medium text-on-accent transition-transform focus:translate-y-0"
    >
      Zum Inhalt springen
    </a>
    <div class="flex min-h-screen flex-col overflow-x-clip">
      {/* Header und Kontextleiste bilden einen sticky Block: die Werte, mit
          denen jede Zahl auf der Seite gerechnet wird, bleiben sichtbar. */}
      <div class="sticky top-0 z-50 border-b border-line bg-canvas/95 backdrop-blur-xs">
        <Header client:load />
        <ContextBar client:load />
      </div>
      <main id="main" class="flex-1">
        <slot />
      </main>
      <AccountSync client:load />
      <CompareTray client:load />
      <Footer />
    </div>
  </body>
</html>
